+  if(value==null) return undefined;
+ const payload=JSON.stringify({kind:'notification',id:value.id,event_id:value.event_id,notification_kind:value.kind,path:value.path,name:value.name,created_at:value.created_at});
+  const sockets=typeof doCtx.getWebSockets==='function'?doCtx.getWebSockets(recipient):[];
