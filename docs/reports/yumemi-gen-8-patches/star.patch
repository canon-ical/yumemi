+export function makeDoContext(state) {
+ const {record,sql,doCtx,seed}=state;
+ const pending=[];
+ const ctx={pending,root:state.root,async stage(name,input) {
+  if(name==='create_notification') {
+   const recipient=c.text(input.recipient),eventId=c.text(input.event_id);
+   if(doFirst(doCtx.storage.sql.exec('SELECT id FROM notification WHERE recipient=? AND event_id=?',recipient,eventId))) return new c.None();
