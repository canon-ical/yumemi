+  ]),
+  Connector(name: "notify", ports: [Send(name: "send", op: "notify")]),
+  Connector(name: "queue", ports: [
+    Enqueue(name: "article_index", kind: "article_index"),
+    Enqueue(name: "notification_fanout", kind: "notification_fanout"),
+    Enqueue(name: "store_request_notify", kind: "store_request_notify"),
+    Enqueue(name: "reservation_notify", kind: "reservation_notify"),
+  ]),
+  Connector(name: "release", ports: [
+    Call(name: "schedule", op: "release_schedule"),
+    Call(name: "unschedule", op: "release_unschedule"),
+  ]),
+  Connector(name: "screen", ports: [Call(name: "judge", op: "screen")]),
+  Connector(name: "socket", ports: [Send(name: "push", op: "socket")]),
+  Connector(name: "workers_ai", ports: [Call(name: "embed", op: "embed")]),
+]
