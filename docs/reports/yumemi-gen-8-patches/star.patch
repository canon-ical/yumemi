+  return true;
+ },async reject() { pending.length=0; },async finish() {
+  if(!pending.length) return;
+  const commitWork=()=>{
+   for(const operation of pending) {
+    if(operation.name==='create_notification') {
+     const value=c.encode(operation.created);
+     doCtx.storage.sql.exec(
+      `INSERT OR IGNORE INTO notification(id,recipient,kind,path,name,created_at,read_at,mailed_at,event_id)
+       VALUES(?,?,?,?,?,?,NULL,NULL,?)`,
+      value.id,value.recipient,value.kind,value.path,value.name,value.created_at,value.event_id,
+     );
+    }
+    if(operation.name==='mark_read_notification') doCtx.storage.sql.exec(
+     'UPDATE notification SET read_at=COALESCE(read_at,?) WHERE id=? AND recipient=?',operation.at,operation.id,c.text(state.party),
+    );
+   }
+  };
+  if(typeof doCtx.storage?.transactionSync==='function') doCtx.storage.transactionSync(commitWork); else commitWork();
+  pending.length=0;
+ }
+ };
+ return ctx;
+}
+export async function invokeDo(state) {
+ const {record,sql,doCtx,at,seed,party}=state;
+ const atValue=c.checked(c.time.datetime(at));
+ let actor,root;
+ const partyId=party?c.checked(c.party.parse(party)):null;
+ if(record.name==='notification_notify') {
+  actor=new allowNotification.SystemActor();
+  root=new record.root.Root(atValue,seed);
+ } else if(record.name==='notification_inbox') {
+  actor=new allowNotification.PartyActor(partyId);
+  root=new record.root.Root(atValue,seed);
+ } else if(record.name==='notification_mark_read') {
+  const id=c.text(state.args.id);
+  const row=doFirst(doCtx.storage.sql.exec(
+   'SELECT id,recipient,kind,path,name,created_at,read_at,mailed_at,event_id FROM notification WHERE id=? AND recipient=?',id,party,
+  ));
+  if(!row) throw Object.assign(new Error('not_found'),{status:404});
+  actor=new allowNotification.PartyActor(partyId);
+  root=new record.root.Root(c.decodeNotification(row),atValue,seed);
+ } else throw new Error('unregistered USER DO service: '+record.name);
+ const context=makeDoContext({...state,root});
+ return step.interpret(record.module.logic(actor,root,state.args),context);
+}
