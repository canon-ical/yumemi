--- a/api/db/queries/schedule_add/candidate_stores.sql	1970-01-01 09:00:00.000000000 +0900
+++ b/api/db/queries/schedule_add/candidate_stores.sql	2026-09-26 02:18:07.000000000 +0900
@@ -0,0 +1,28 @@
+WITH candidates AS (
+ SELECT t.id AS target_id,s.store_id,s.store_name,s.type,s.genre,s.area_id,false AS listed
+ FROM app.shift_target t
+ JOIN public.store s ON s.store_id=t.ledger_store_id
+ WHERE t.muse_id=$1::uuid
+ UNION ALL
+ SELECT NULL::uuid,s.store_id,s.store_name,s.type,s.genre,s.area_id,true
+ FROM app.roster r
+ JOIN app.store a ON a.id=r.store_id
+ JOIN public.store s ON s.store_id=a.ledger_store_id
+ WHERE r.muse_id=$1::uuid
+   AND r.phase='active'
+   AND a.ledger_store_id IS NOT NULL
+), folded AS (
+ SELECT DISTINCT ON (store_id)
+        target_id,store_id,store_name,type,genre,area_id,
+        bool_or(listed) OVER (PARTITION BY store_id) AS listed
+ FROM candidates
+ ORDER BY store_id,target_id NULLS LAST
+)
+SELECT f.target_id,f.store_id,f.store_name,f.type,f.genre,
+       NULLIF(concat_ws(' > ',g.name,p.name,a.name),'') AS area,
+       f.listed
+FROM folded f
+LEFT JOIN public.area a ON a.area_id=f.area_id
+LEFT JOIN public.area p ON p.area_id=a.parent_id
+LEFT JOIN public.area g ON g.area_id=p.parent_id
+ORDER BY f.store_name,f.store_id;
