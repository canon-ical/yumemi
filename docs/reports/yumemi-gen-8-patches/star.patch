+//// GENERATED from connector.heaven declaration — 手で編集しない
+// GENERATED connector boundary for Heaven.  The public connector functions
+// delegate through Context; the *Page helper is the implementation used by
+// gen/runtime.call and is kept separate to avoid a call -> call cycle.
+
+import { firstHostFor } from "./external_hosts.mjs";
+
+const PUBLIC_HOST = firstHostFor("heaven-page");
+const WIDGET_HOST = firstHostFor("heaven-widget");
+const USER_AGENT = "Mozilla/5.0";
+const CACHE_TTL_MS = 60 * 1000;
+const CACHE_MAX = 128;
+const resolvedCache = new Map();
+
+// ORDER-05: only the public girl's page shape is accepted.  Query and hash
+// are deliberately ignored by this predicate and stripped before the GET.
+const GIRL_PATH =
+  /^\/([a-z]+)\/([A-Za-z0-9]+)\/([A-Za-z0-9]+)\/([A-Za-z0-9_.-]+)\/girlid-(\d+)\/?$/;
+
+function parseGirlUrl(input) {
+  let url;
+  try {
+    url = new URL(String(input));
+  } catch {
+    return null;
+  }
+  if (url.protocol !== "https:" || url.hostname !== PUBLIC_HOST) return null;
+  const match = GIRL_PATH.exec(url.pathname);
+  if (!match) return null;
+  const path = match[0].endsWith("/") ? match[0] : `${match[0]}/`;
+  return {
+    url: `https://${PUBLIC_HOST}${path}`,
+    girlId: match[5],
+  };
+}
+
+export function isGirlPage(input) {
+  return parseGirlUrl(input) !== null;
+}
+
+const entities = Object.freeze({
+  amp: "&",
+  apos: "'",
+  gt: ">",
+  lt: "<",
+  nbsp: "\u00a0",
+  quot: '"',
+});
+
+function decodeEntities(value) {
+  return String(value).replace(
+    /&(#x?[0-9a-fA-F]+|[a-zA-Z]+);/g,
+    (whole, body) => {
+      if (body[0] === "#") {
+        const code =
+          body[1]?.toLowerCase() === "x"
+            ? Number.parseInt(body.slice(2), 16)
+            : Number.parseInt(body.slice(1), 10);
+        return Number.isFinite(code) && code > 0 && code <= 0x10ffff
+          ? String.fromCodePoint(code)
+          : whole;
+      }
+      return entities[body.toLowerCase()] ?? whole;
+    },
+  );
+}
+
+function decodeString(value) {
+  const source = String(value);
+  try {
+    // Values from the Next.js RSC payload are JSON-string escaped.  Parsing a
+    // quoted value also handles \\/, \\uXXXX, and escaped quotation marks.
+    return decodeEntities(JSON.parse(`"${source}"`));
+  } catch {
+    return decodeEntities(
+      source
+        .replaceAll('\\"', '"')
+        .replaceAll("\\/", "/")
+        .replaceAll("\\n", "\n")
+        .replaceAll("\\r", "\r")
+        .replaceAll("\\t", "\t"),
+    );
+  }
+}
+
+function quotedKey(key) {
+  // The same matcher accepts ordinary HTML JSON and RSC's \"key\" spelling.
+  return `\\\\?"${key}\\\\?"`;
+}
+
+function fieldMatches(source, key) {
+  const value = String(source);
+  const re = value.includes("\\")
+    ? new RegExp(`${quotedKey(key)}\\s*:\\s*\\\\?"([^"\\\\]*?)\\\\?"`, "g")
+    : new RegExp(`"${key}"\\s*:\\s*"((?:\\\\.|[^"\\\\])*)"`, "g");
+  return [...value.matchAll(re)].map((match) => ({
+    index: match.index ?? 0,
+    value: decodeString(match[1]),
+  }));
+}
+
+function fieldBefore(source, key, position) {
+  const found = fieldMatches(String(source).slice(0, position), key);
+  return found.at(-1)?.value ?? null;
+}
+
+function fieldAfter(source, key, position) {
+  const found = fieldMatches(String(source).slice(position), key);
+  return found[0]?.value ?? null;
+}
+
+function extractTitle(source) {
+  const match = /<title\b[^>]*>([\s\S]*?)<\/title>/i.exec(String(source));
+  return match ? decodeEntities(match[1]).replace(/\s+/g, " ").trim() : null;
+}
+
+function extractGirlIdFromPath(source) {
+  return /\/girlid-(\d+)\/?(?:[?#]|$)/i.exec(String(source))?.[1] ?? null;
+}
+
+const TITLE_RE =
+  /^「([^」]+)」(.+?)\s*[-‐‑‒–—―−－]\s*(.+)\/([^\/]+)\s*[｜|]\s*シティヘブンネット$/;
+
+function parseGirlTitle(title) {
+  if (title === null || title === undefined) return null;
+  const match = TITLE_RE.exec(String(title).replace(/\s+/g, " ").trim());
+  if (!match) return null;
+  const name = match[1].trim();
+  const shopName = match[2].trim();
+  return name && shopName ? { name, shopName } : null;
+}
+
+function extractShopSources(source) {
+  const value = String(source);
+  const first = (re) => value.match(re)?.[1] ?? null;
+  return {
+    data: first(/data-c_commu_id\s*=\s*["']?(\d+)/i),
+    dataLayer: first(
+      /dataLayer\s*\.\s*push\s*\(\s*\{[^}]*["']shop_id["']\s*:\s*["']?(\d+)/i,
+    ),
+    review: first(
+      /\/mypage\/review\/edit\/\?[^"'<>\s]*?\bc_commu_id=(\d+)/i,
+    ),
+  };
+}
+
+function failure(module, name, value) {
+  const ctor = module[name];
+  if (typeof ctor !== "function") throw new Error(`missing Heaven variant ${name}`);
+  return new ctor(...(value === undefined ? [] : [value]));
+}
+
+async function constructors() {
+  const [module, option] = await Promise.all([
+    import("./connector/heaven.mjs"),
+    import("../gleam_stdlib/gleam/option.mjs"),
+  ]);
+  return { module, option };
+}
+
+async function unresolved(name, status) {
+  const { module, option } = await constructors();
+  let reason;
+  if (name === "FetchFailed") {
+    reason = failure(module, name, status === null ? new option.None() : new option.Some(status));
+  } else {
+    reason = failure(module, name);
+  }
+  return new module.Unresolved(reason);
+}
+
+async function resolved(shopId, girlId, shopName, name) {
+  const [module, heavenId, storeName, nameType] = await Promise.all([
+    import("./connector/heaven.mjs"),
+    import("./gen/types/heaven_id.mjs"),
+    import("./gen/types/store_name.mjs"),
+    import("./gen/types/name.mjs"),
+  ]);
+  const checked = (type, value) => {
+    const result = type.parse(value);
+    if (!result.isOk()) throw new Error("invalid resolved Heaven value");
+    return result[0];
+  };
+  return new module.Resolved(
+    checked(heavenId, shopId),
+    checked(heavenId, girlId),
+    checked(storeName, shopName),
+    checked(nameType, name),
+  );
+}
+
+function responseHasWaf(response, body) {
+  const marker = String(body);
+  return (
+    response.status === 403 ||
+    response.status === 503 ||
+    response.headers.get("cf-mitigated") !== null ||
+    marker.includes("challenge-platform") ||
+    marker.includes("Just a moment") ||
+    marker.includes("Attention Required")
+  );
+}
+
+/**
+ * The implementation called by runtime.call("heaven_resolve").
+ * It intentionally performs at most one GET and never forwards cookies.
+ */
+export async function resolvePage(input, fetchImpl = globalThis.fetch) {
+  const parsed = parseGirlUrl(input);
+  if (!parsed) return unresolved("FetchFailed", null);
+  // Only the Worker-global fetch path uses the isolate cache.  Tests and
+  // callers that inject a fetch function always observe their own request.
+  const cacheable = fetchImpl === globalThis.fetch;
+  if (cacheable) {
+    const cached = resolvedCache.get(parsed.url);
+    if (cached && cached.expiresAt > Date.now()) return cached.value;
+    if (cached) resolvedCache.delete(parsed.url);
+  }
+
+  let response;
+  try {
+    response = await fetchImpl(parsed.url, {
+      method: "GET",
+      redirect: "manual",
+      headers: { accept: "text/html,*/*", "user-agent": USER_AGENT },
+    });
+  } catch {
+    return unresolved("FetchFailed", null);
+  }
+
+  const body = response.status === 200 ? await response.text() : "";
+  if (responseHasWaf(response, body)) return unresolved("Waf");
+  if (response.status !== 200) return unresolved("FetchFailed", response.status);
+
+  const sources = extractShopSources(body);
+  const shopIds = [sources.data, sources.dataLayer, sources.review].filter(Boolean);
+  if (shopIds.length === 0) return unresolved("NoShopId");
+  if (!shopIds.every((value) => value === shopIds[0])) {
+    return unresolved("ShopIdMismatch");
+  }
+
+  const title = parseGirlTitle(extractTitle(body));
+  if (!title) return unresolved("TitleMismatch");
+
+  const girlId = parsed.girlId || extractGirlIdFromPath(parsed.url);
+  try {
+    const value = await resolved(shopIds[0], girlId, title.shopName, title.name);
+    if (cacheable) {
+      while (resolvedCache.size >= CACHE_MAX) resolvedCache.delete(resolvedCache.keys().next().value);
+      resolvedCache.set(parsed.url, { value, expiresAt: Date.now() + CACHE_TTL_MS });
+    }
+    return value;
+  } catch {
+    return unresolved("TitleMismatch");
+  }
+}
+
+/**
+ * The generated connector wrapper.  Keep this separate from resolvePage:
+ * Context.call is the runtime injection point used by tests and Workers.
+ */
+export function resolve(context, input) {
+  return context.call("heaven_resolve", input);
+}
+
+export function embedSrc(shopId, girlId, mode, design, num, color, fontsize, width) {
+  const query = new URLSearchParams([
+    ["shopId", String(shopId)],
+    ["mode", String(mode)],
+    ["type", String(design)],
+    ["girlId", String(girlId)],
+    ["limitedKind", ""],
+    ["num", String(num)],
+    ["color", String(color)],
+    ["fontsize", String(fontsize)],
+    ["width", String(width)],
+  ]);
+  return `https://${WIDGET_HOST}/widget/?${query.toString()}`;
+}
+
+export const __test = Object.freeze({
+  clearCache: () => resolvedCache.clear(),
+  extractGirlTitle: parseGirlTitle,
+  extractShopSources,
+  parseGirlUrl,
+});
