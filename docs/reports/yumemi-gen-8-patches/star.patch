+// connector の FFI の口(鷹野の裁定 2)。型と typed な包みは ★ `src/connector/<name>.gleam`、
+// Heaven / lit.link の取得の実装は ★ `src/heaven_ffi.mjs` / `src/litlink_ffi.mjs`。
+pub const connectors: List(server.Connector) = [
+  Connector(name: "heaven", ports: [
+    Pure(name: "is_girl_page", module: "heaven_ffi", js: "isGirlPage", arity: 1),
+    Fetch(name: "resolve", module: "heaven_ffi", js: "resolve", arity: 1),
