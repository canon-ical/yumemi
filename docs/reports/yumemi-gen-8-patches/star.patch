@@ -0,0 +1,9 @@
+SELECT s.store_id,s.store_name,s.type,s.genre,
+       NULLIF(concat_ws(' > ',g.name,p.name,a.name),'') AS area
+FROM public.store s
+LEFT JOIN public.area a ON a.area_id=s.area_id
+LEFT JOIN public.area p ON p.area_id=a.parent_id
+LEFT JOIN public.area g ON g.area_id=p.parent_id
+WHERE s.store_name ILIKE '%' || $1 || '%'
+ORDER BY s.store_name ASC,s.store_id ASC
+LIMIT 50;
