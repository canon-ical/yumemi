+export async function callInvite(input,x) {
+ const binding=x.env?.AUTH;
+ if(!binding||typeof binding.invite!=='function') throw new Error('auth binding is missing');
+ try {
+  const result=await binding.invite(c.text(input));
+  return new idp.Invited(c.checked(c.party.parse(String(result?.party??''))));
