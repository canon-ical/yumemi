+  const taken=await run(s.db,'roster_upsert/same_name',[s.resolved?.subject_id,args.name]);
+  return x.response(s,{code:'name_taken',id:taken[0]?.id??null},409);
+ }
+ if(row.phase!=='active') return x.response(s,{code:'not_active'},422);
