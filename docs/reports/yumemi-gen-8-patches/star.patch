+ if(error.code==='P0001'&&name==='roster_upsert') return x.response(s,{code:'not_active'},422);
+ if(error.code==='23P01'&&error.constraint==='muse_schedule_party_exclude') return x.response(s,{code:'overlaps_own_schedule'},422);
+ if(error.code==='P0001'&&name==='store_link_ledger'&&error.message==='already_linked') return x.response(s,{code:'already_linked'},409);
+ if(error.code==='P0001'&&name==='reservation_send'&&error.message==='already_sent') return x.response(s,{code:'already_sent'},409);
+ if(error.code==='23505') {
+  if(['muse_handle_key','fan_handle_key','store_handle_key'].includes(error.constraint)) return x.response(s,{code:'handle_taken'},422);
+  if(error.constraint==='store_unique_ledger_store') return x.response(s,{code:'ledger_store_taken'},409);
+  if(error.constraint==='course_unique_active_name') return x.response(s,{code:'name_taken'},409);
+  if(error.constraint==='notice_reservation_unique') return x.response(s,{code:'already_sent'},409);
+  if(error.constraint==='shift_target_muse_ledger_unique') return x.response(s,{code:'already_target'},422);
+  if(error.constraint==='article_unique_slot') return x.response(s,{code:'slot_taken'},422);
+  if(['roster_unique_name','roster_unique_external'].includes(error.constraint)&&name==='roster_upsert') return recoverRosterUpsert(s,x);
+  if(error.constraint==='roster_unique_name') {
+   const rows=await run(s.db,'roster_add/same_name',[s.resolved?.subject_id??null,c.text(s.args?.name)]).catch(()=>[]);
+   return x.response(s,{code:'name_taken',id:rows[0]?.id??null},409);
+  }
+  if(error.constraint==='roster_unique_party'||error.constraint==='roster_unique_muse') return x.response(s,{code:'persona_already_on_store'},409);
+ }
+ return undefined;
+}
