+import { hostSetFor } from "./external_hosts.mjs";
+
+const HOSTS = hostSetFor("litlink");
+const USER_AGENT = "Mozilla/5.0";
+const IMAGE_HOSTS = hostSetFor("blob");
+
+function requestedUrl(input) {
+  let url;
+  try {
+    url = new URL(String(input));
+  } catch {
+    return null;
+  }
+  if (url.protocol !== "https:" || !HOSTS.has(url.hostname)) return null;
+  // A public profile is the only page this connector reads.  The locale form
+  // (`/en/name`) is accepted as observed in the survey.
+  const parts = url.pathname.split("/").filter(Boolean);
+  if (parts.length < 1 || parts.length > 2 || parts.some((part) => !/^[A-Za-z0-9_-]+$/.test(part))) return null;
+  url.search = "";
+  url.hash = "";
