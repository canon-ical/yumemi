+  await f.probe('widget_list/published','inside',[f.x,false,null,null,null,null],h.ids,[f.a]);
+  await f.probe('widget_list/published','inside',[f.x,true,1,null,null,null],h.ids,[f.a]);
+  await f.probe('widget_list/published','outside',[f.x,true,2,null,null,null],h.ids,[]);
+ });
+}
