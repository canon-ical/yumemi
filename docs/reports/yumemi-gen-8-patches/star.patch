+     FROM notification WHERE recipient=?${clause} ORDER BY created_at DESC,id DESC LIMIT 21`,...params,
+   ));
+   const visible=rows.slice(0,20),last=visible.at(-1);
+   const next=rows.length>20?doCursorText(last.created_at,last.id):null;
+   const cursor=next?c.checked(c.page.cursor(next)):null;
