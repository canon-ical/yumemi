+++ b/api/db/queries/framework/session_resolve_staff.sql	2026-09-26 02:18:07.000000000 +0900
@@ -0,0 +1,66 @@
+WITH original AS MATERIALIZED (
+ SELECT * FROM framework.session WHERE id=$1 AND revoked_at IS NULL
+ AND expires_at>$2::timestamptz AND created_at+interval '180 days'>$2::timestamptz
+), subject AS MATERIALIZED (
+ SELECT 'muse'::text AS kind,m.id,m.party,m.handle,m.phase FROM app.muse m
+ JOIN original s ON s.subject_kind='muse' AND s.subject_id=m.id
+ UNION ALL
+ SELECT 'store',m.id,m.party,m.handle,m.phase FROM app.store m
+ JOIN original s ON s.subject_kind='store' AND s.subject_id=m.id
+ UNION ALL
+ SELECT 'fan',f.id,f.party,f.handle,f.phase FROM app.fan f
+ JOIN original s ON s.subject_kind='fan' AND s.subject_id=f.id
+ UNION ALL
+ SELECT 'staff',st.id,st.party,NULL::text,NULL::text FROM app.staff st
+ JOIN original s ON s.subject_kind='staff' AND s.subject_id=st.id
+), resolved AS MATERIALIZED (
+ SELECT s.*, t.party AS subject_party,
+ CASE WHEN t.phase='retired' OR t.id IS NULL THEN NULL ELSE t.kind END AS next_kind,
+ CASE WHEN t.phase='retired' OR t.id IS NULL THEN NULL ELSE t.id END AS next_id,
+ CASE WHEN t.phase='retired' OR t.id IS NULL THEN NULL ELSE t.handle END AS handle,
+ CASE WHEN t.phase='retired' OR t.id IS NULL THEN NULL ELSE t.phase END AS phase,
+ s.expires_at<$2::timestamptz+interval '15 days' AS extend,
+ (s.subject_kind IS NOT NULL AND (t.id IS NULL OR t.phase='retired')) AS clear_subject
+ FROM original s LEFT JOIN subject t ON true
+), changed AS (
+ UPDATE framework.session s SET subject_kind=r.next_kind,subject_id=r.next_id,
+ expires_at=CASE WHEN r.extend THEN LEAST($2::timestamptz+interval '30 days',s.created_at+interval '180 days') ELSE s.expires_at END
+ FROM resolved r WHERE $3::boolean AND (r.extend OR r.clear_subject)
+ AND (r.subject_party IS NULL OR r.subject_party=r.party)
+ AND s.id=r.id AND s.revoked_at IS NULL AND s.expires_at>$2::timestamptz
+ AND (s.subject_kind,s.subject_id) IS NOT DISTINCT FROM (r.subject_kind,r.subject_id)
+ RETURNING s.subject_kind,s.subject_id,s.expires_at
+)
+SELECT r.id,r.party,r.subject_party,r.next_kind AS subject_kind,r.next_id AS subject_id,r.handle,r.phase,
+ COALESCE(c.expires_at,r.expires_at) AS expires_at,r.created_at,
+ (SELECT to_jsonb(m) FROM app.muse m WHERE r.next_kind='muse' AND m.id=r.next_id) AS muse,
+ (SELECT to_jsonb(st) FROM app.store st WHERE r.next_kind='store' AND st.id=r.next_id) AS store,
+ (SELECT to_jsonb(f) FROM app.fan f WHERE r.next_kind='fan' AND f.id=r.next_id) AS fan,
+ ($3::boolean AND (r.extend OR r.clear_subject) AND c.expires_at IS NULL AND (r.subject_party IS NULL OR r.subject_party=r.party)) AS retry,
+ (r.extend AND c.expires_at IS NOT NULL) AS extended,
+ EXISTS(SELECT 1 FROM app.measure m WHERE m.target=r.party AND m.kind='suspend'
+ AND (m.until IS NULL OR m.until>$2::timestamptz)
+ AND NOT EXISTS(SELECT 1 FROM app.measure l WHERE l.kind='lift' AND l.report_id=m.report_id)) AS suspended,
+ COALESCE((SELECT jsonb_agg(jsonb_build_object('kind',v.kind,'subject',v.subject)) FROM app.consent v
+ JOIN app.consent_version cv ON cv.kind=v.kind AND cv.version=v.version
+ WHERE v.party=r.party),'[]') AS consents,
+ COALESCE((SELECT jsonb_agg(subject)
+ FROM (
+   SELECT jsonb_build_object('kind','muse','id',m.id,'handle',m.handle,'phase',m.phase) AS subject
+   FROM app.muse m
+   WHERE m.party=r.party AND m.phase IN ('onboarded','retiring')
+   UNION ALL
+   SELECT jsonb_build_object('kind','store','id',st.id,'handle',st.handle,'phase',NULL::text) AS subject
+   FROM app.store st
+   WHERE st.party=r.party
+   UNION ALL
+   SELECT jsonb_build_object('kind','fan','id',f.id,'handle',f.handle,'phase',f.phase) AS subject
+   FROM app.fan f
+   WHERE f.party=r.party AND f.phase IN ('onboarded','retiring')
+   UNION ALL
+   SELECT jsonb_build_object('kind','staff','id',st.id,'handle',NULL::text,'phase',NULL::text) AS subject
+   FROM app.staff st
+   WHERE st.party=r.party
+ ) available),'[]') AS subjects,
+ (SELECT to_jsonb(st) FROM app.staff st WHERE r.next_kind='staff' AND st.id=r.next_id) AS staff
+FROM resolved r LEFT JOIN changed c ON true;
diff -ruN -x gen -x build -x node_modules -x '*.tgz' snap-base-pristine/api/db/queries/framework/session_subject_staff.sql snap-g/api/db/queries/framework/session_subject_staff.sql
