+    Hooked(service: "metrics_rollup", hook: "metrics_rollup_args"),
+    EachDue(service: "article_release", query: "due"),
+  ]),
+]
+
+pub const durable_objects: List(server.DurableObject) = [
+  DurableObject(
+    class: "MusearchUserDo",
+    module: "user_do",
+    adapter: "UserDoAdapter",
+    methods: [
+      "fetch", "webSocketMessage", "webSocketClose", "webSocketError", "notify",
+      "inbox", "markRead",
+    ],
+  ),
+  DurableObject(
+    class: "MusearchReleaseDo",
+    module: "release_do",
+    adapter: "ReleaseDoAdapter",
+    methods: ["schedule", "unschedule", "alarm"],
+  ),
+]
+
+pub const hooks: List(server.Hook) = [
+  Hook(name: "metrics_rollup_args", module: "hooks"),
+  // codec: 店の時刻を分の整数で持つ列(muse_schedule / reservation / prep)、秘密を読まない店、台帳の店、
+  // 集計の値、記事の頁と cursor ── 列の形が宣言と違うので、生成の codec が名指しで re-export する。
+  Hook(name: "decode_muse_schedule", module: "hooks"),
+  Hook(name: "decode_reservation", module: "hooks"),
+  Hook(name: "decode_prep", module: "hooks"),
+  Hook(name: "decode_course", module: "hooks"),
+  Hook(name: "decode_store", module: "hooks"),
+  Hook(name: "decode_muse_setting_spec", module: "hooks"),
+  Hook(name: "decode_ledger_store", module: "hooks"),
+  Hook(name: "decode_metrics", module: "hooks"),
+  Hook(name: "decode_metrics_store", module: "hooks"),
+  Hook(name: "decode_page", module: "hooks"),
+  Hook(name: "cursor_args", module: "hooks"),
+]
