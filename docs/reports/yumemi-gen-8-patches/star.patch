+async function releaseObject(x,articleId) {
+ const binding=x.env?.RELEASE_DO;
+ if(!binding||typeof binding.idFromName!=='function'||typeof binding.get!=='function') throw new Error('release DO binding is missing');
+ if(typeof articleId!=='string'||!articleId) throw new Error('release DO article id is missing');
+ const object=binding.get(binding.idFromName(articleId),{locationHint:'apac'});
+ if(!object) throw new Error('release DO object is missing');
+ return object;
+}
