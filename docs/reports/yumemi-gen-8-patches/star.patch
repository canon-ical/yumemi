+   const created=new notificationDraft.NotificationCreated(
+    c.parse('notification_id',id),input.recipient,input.kind,input.path,input.name,input.created_at,input.read_at,input.mailed_at,input.event_id,
+   );
+   pending.push({name,created,input});
+   return new c.Some(created);
+  }
+  if(name==='mark_read_notification') {
+   pending.push({name,id:c.text(input[0]),at:c.text(input[1])});
