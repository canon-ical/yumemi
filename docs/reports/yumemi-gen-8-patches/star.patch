+// ★ src/hooks.mjs ── 宣言から導けない業務の行(src/server.gleam の hooks)。生成物はここに名を宣言した関数だけを import する。
+// metrics_rollup_args: 日次の rollup の期間(JST の前日、月初なら前月、保持月数より古い行の purge の境)。
+function dateText(value) {
+ return [value.getUTCFullYear(),String(value.getUTCMonth()+1).padStart(2,'0'),String(value.getUTCDate()).padStart(2,'0')].join('-');
+}
+function cronPeriods(at,retentionMonths) {
+ const jst=new Date(Date.parse(at)+9*60*60*1000);
+ const previous=new Date(Date.UTC(jst.getUTCFullYear(),jst.getUTCMonth(),jst.getUTCDate()-1));
+ const month=jst.getUTCDate()===1
+  ? dateText(new Date(Date.UTC(jst.getUTCFullYear(),jst.getUTCMonth()-1,1)))
+  : null;
+ const monthIndex=jst.getUTCMonth()-retentionMonths;
+ const targetYear=jst.getUTCFullYear()+Math.floor(monthIndex/12);
+ const targetMonth=((monthIndex%12)+12)%12;
+ const lastDay=new Date(Date.UTC(targetYear,targetMonth+1,0)).getUTCDate();
+ const targetDay=Math.min(jst.getUTCDate(),lastDay);
+ const purge=new Date(Date.UTC(
+  targetYear,targetMonth,targetDay,jst.getUTCHours(),jst.getUTCMinutes(),jst.getUTCSeconds(),jst.getUTCMilliseconds(),
+ )-9*60*60*1000).toISOString();
+ return {day:dateText(previous),month,purge};
+}
+export function metricsRollupArgs(at,module,c) {
+ const periods=cronPeriods(at,Number(module.retention_months));
