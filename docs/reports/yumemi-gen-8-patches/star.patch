+// ★ src/connector/heaven.gleam ── connector.heaven の型と typed な包み(WGy r2、鷹野の裁定 2)。FFI の口は生成物 gen/connector/heaven。
+
+import framework/connector
+import gen/connector/heaven as port
+import gen/types/heaven_color.{type HeavenColor}
+import gen/types/heaven_fontsize.{type HeavenFontsize}
+import gen/types/heaven_id.{type HeavenId}
+import gen/types/heaven_num.{type HeavenNum}
+import gen/types/name.{type Name}
+import gen/types/page_url.{type PageUrl}
+import gen/types/store_name.{type StoreName}
+import gleam/option.{type Option}
+
+pub type Failure {
+  Waf
+  FetchFailed(status: Option(Int))
+  NoShopId
+  ShopIdMismatch
+  TitleMismatch
+}
+
+pub type Resolution {
+  Resolved(
+    shop_id: HeavenId,
+    girl_id: HeavenId,
+    shop_name: StoreName,
+    name: Name,
+  )
+  Unresolved(reason: Failure)
+}
+
+pub fn is_girl_page(url: PageUrl) -> Bool {
+  port.is_girl_page(page_url.to_string(url))
+}
+
+pub fn resolve(url: PageUrl) -> connector.Read(Resolution) {
+  port.resolve(page_url.to_string(url))
+}
+
+pub fn embed_src(
+  shop_id shop_id: HeavenId,
+  girl_id girl_id: HeavenId,
+  mode mode: Int,
+  design design: Int,
+  num num: HeavenNum,
+  color color: HeavenColor,
+  fontsize fontsize: HeavenFontsize,
+  width width: Int,
+) -> String {
+  port.embed_src(
+    heaven_id.to_string(shop_id),
+    heaven_id.to_string(girl_id),
+    mode,
+    design,
+    heaven_num.to_int(num),
+    heaven_color.to_int(color),
+    heaven_fontsize.to_int(fontsize),
+    width,
+  )
+}
